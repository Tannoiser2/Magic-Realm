## godot --headless --path . --script res://tests/cavalli_classici_test.gd
extends SceneTree

func _init() -> void:
	assert(CavalliClassici.SPEC.size() == 17)
	assert(CavalliClassici.STALLE["bashkars"].size() == 6)
	assert(CavalliClassici.STALLE["rogues"].size() == 6)
	assert(CavalliClassici.STALLE["order"].size() == 3)
	var g := Reame.new()
	assert(g.nuova_con_profilo(ProfiliRegole.classico_incontro(1), "elfo", [], 3331))
	assert(g.usa_regola("cavalli"))
	assert(g.s["nativi"]["bashkars"]["box"]["cavalli"].size() == 6)
	assert(g.s["nativi"]["rogues"]["box"]["cavalli"].size() == 6)
	assert(g.s["nativi"]["order"]["box"]["cavalli"].size() == 3)
	var p: Dictionary = g.umano()
	p["cavalli"].append(CavalliClassici.nuovo("pony_m2"))
	assert(CavalliClassici.attiva(p, "pony_m2", g.carico_max(p), g.vulnerabilita(p), false))
	assert(not CavalliClassici.attivo(p).is_empty())
	var phases: Dictionary = g.fasi_disponibili(p)
	assert(phases["extra"].count("MP") == 4 + phases["extra"].count("M"))
	var st := {"base":0, "luce":0, "extra":phases["extra"].duplicate(), "grotta":false, "max_luce":2, "mosse_normali":0, "mosse_pony":0}
	assert(g._slot(p, st, "M") != "pony")
	assert(g._slot(p, st, "M") == "pony")
	assert(int(st["mosse_pony"]) == 1)
	p["cavalli"].append(CavalliClassici.nuovo("lavoro_h6t8"))
	assert(CavalliClassici.attiva(p, "lavoro_h6t8", g.carico_max(p), g.vulnerabilita(p), false))
	assert(not p["cavalli"][0]["attivo"])
	assert(g.fasi_disponibili(p)["extra"].count("MC") == 1)
	assert(CavalliClassici.portata(p, 0) == Dati.peso_i("T"))
	assert(CavalliClassici.attiva(p, "lavoro_h6t8", g.carico_max(p), g.vulnerabilita(p), true))
	var c: Dictionary = CavalliClassici.attivo(p)
	assert(c.is_empty())
	assert(not CavalliClassici.attiva(p, "lavoro_h6t8", g.carico_max(p), g.vulnerabilita(p), true))
	var saved: Dictionary = JSON.parse_string(JSON.stringify(g.esporta()))
	var other := Reame.new()
	other.importa(saved)
	assert(other.umano()["cavalli"].size() == 2)
	assert(not ProfiliRegole.super_scenario(6)["funzioni"]["cavalli"])
	assert("horse:pony_l2" in g.s["twt"]["w_enchanted_meadow"]["carte"])
	assert("horse:guerra_t3" in g.s["twt"]["w_crypt_of_the_knight"]["carte"])
	var prima: int = p["cavalli"].size()
	g.arcano._ricevi_carta(p, "horse:pony_l2", [], false)
	assert(p["cavalli"].size() == prima + 1)
	assert(p["cavalli"][-1]["id"] == "pony_l2")
	print("PASS: original horse inventory, shops, riding, pack load, pony/workhorse phases and saves")
	quit()
